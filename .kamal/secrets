# Secrets are referenced in config/deploy.yml under env/secret and accessories/*/env/secret.
# Pull from ENV or password manager — never hardcode values here.

RAILS_MASTER_KEY=$(cat config/master.key)
POSTGRES_PASSWORD=$POSTGRES_PASSWORD_SMARTS
# Wrap defaults in $(...) so a real shell expands them. Kamal's own parsing of
# this file does NOT implement bash's ${VAR:-default}: it strips the ${VAR part
# and leaves the literal ":-https://...}", which reaches the container as a
# malformed URL and takes the chain's RPC offline.
ROBINHOOD_RPC_URL=$(echo ${ROBINHOOD_RPC_URL_SMARTS:-https://rpc.mainnet.chain.robinhood.com})
ARC_RPC_URL=$(echo ${ARC_RPC_URL_SMARTS:-https://rpc.mainnet.arc.io})

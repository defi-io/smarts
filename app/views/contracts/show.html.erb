<%= turbo_stream_from @contract %>

<%
  contract_name = contract_display_name
  current_contract_path = localized_contract_path(locale: I18n.locale, slug: @canonical_slug, chain_slug: @chain.slug, address: @contract.address)
  seo_title = "#{contract_name} on #{@chain.name} — live on-chain contract docs"
  seo_desc  = Seo::Copy.contract(
    contract_name: contract_name,
    chain_name: @chain.name,
    classification: @classification,
    address: @contract.display_address
  )
  seo_canonical = "#{SeoHelper::SITE_URL}#{current_contract_path}"
  seo_meta title: seo_title, description: seo_desc, canonical: seo_canonical
%>

<% content_for :head do %>
  <%= render_json_ld(Seo::JsonLd.contract(
    contract: @contract,
    chain: @chain,
    classification: @classification,
    display_name: contract_name,
    canonical_url: seo_canonical,
    title: seo_title,
    description: seo_desc
  )) %>
  <%= render_json_ld(Seo::JsonLd.breadcrumb([
    { name: "Smarts", url: "#{SeoHelper::SITE_URL}/" },
    { name: "#{contract_name} on #{@chain.name}", url: seo_canonical }
  ])) %>
  <% I18n.available_locales.each do |locale| %>
    <link rel="alternate" hreflang="<%= locale %>" href="<%= SeoHelper::SITE_URL %><%= localized_contract_path(locale: locale, slug: @canonical_slug, chain_slug: @chain.slug, address: @contract.address) %>">
  <% end %>
  <link rel="alternate" hreflang="x-default" href="<%= SeoHelper::SITE_URL %><%= localized_contract_path(locale: I18n.default_locale, slug: @canonical_slug, chain_slug: @chain.slug, address: @contract.address) %>">
<% end %>

<%# Inner px-0 — outer <main> in the layout already supplies horizontal
    padding. Doubling was wasting ~72px of mobile width. %>
<div class="max-w-5xl mx-auto py-4 sm:py-8">
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-2 flex-wrap">
      <h1 class="text-3xl font-bold"><%= contract_name %></h1>
      <span class="badge badge-primary"><%= @chain.name %></span>
      <% if contract_protocol_badge.present? %>
        <span class="badge badge-outline" title="<%= contract_protocol_description %>">
          <%= contract_protocol_badge %>
        </span>
      <% end %>
      <%= link_to t('contracts.show.browse_chains'), public_chains_index_path, class: "text-sm font-semibold text-sky-600 underline decoration-sky-400/40 underline-offset-4 hover:text-sky-500" %>
    </div>
    <p class="font-mono text-sm opacity-70 break-all"><%= @contract.address %></p>
    <% if @contract.implementation_address.present? %>
      <p class="text-sm opacity-70 mt-1 break-all">
        <span class="badge badge-ghost badge-sm">Proxy</span>
        <span class="opacity-60"><%= t('contracts.show.implementation') %></span>
        <span class="font-mono"><%= @contract.implementation_address %></span>
      </p>
    <% end %>
    <% if @contract.compiler_version.present? %>
      <p class="text-sm opacity-50 mt-1">Solidity <%= @contract.compiler_version %></p>
    <% end %>
    <% if contract_protocol_description.present? %>
      <p class="text-sm opacity-70 mt-2 italic"><%= contract_protocol_description %></p>
    <% end %>
  </div>

  <%= render "contracts/mcp_info" %>

  <% if @chain.full? %>
    <%# Protocol adapter panel — loaded eagerly via Turbo Frame so the shell
        itself skips the RPC / API calls that panel_data triggers. %>
    <turbo-frame id="contract_live" src="<%= contract_island_path("live") %>" loading="eager">
      <div class="skeleton h-32 w-full rounded-lg mb-6"></div>
    </turbo-frame>

    <%= render "contracts/admin_risk" %>
  <% else %>
    <div class="alert alert-info mb-6">
      <%= t('contracts.show.docs_only_notice', chain: @chain.name) %>
    </div>
  <% end %>

  <%# data-turbo-permanent on each tab radio so user's selection survives the
      background-job-triggered Turbo morph refresh. Server-rendered `checked`
      still wins on initial load (when there's no client state to preserve). %>
  <div role="tablist" class="tabs tabs-lift tabs-sm md:tabs-lg"
       data-controller="contract-tabs"
       <% if @chain.full? %>
       data-contract-tabs-activity-url-value="<%= contract_island_path("activity") %>"
       <% end %>
       data-contract-tabs-source-url-value="<%= contract_island_path("source") %>">
    <input id="contract_tab_docs" data-turbo-permanent type="radio" name="contract_view" role="tab" class="tab" aria-label="<%= t('contracts.show.tab_docs') %>" checked />
    <div role="tabpanel" class="tab-content bg-base-100 border-base-300 p-6">
      <%= render "contracts/docs" %>
    </div>

    <% if @chain.full? %>
      <input id="contract_tab_activity" data-turbo-permanent type="radio" name="contract_view" role="tab" class="tab" aria-label="<%= t('contracts.show.tab_activity') %>" data-contract-tabs-target="activity" data-action="change->contract-tabs#loadTab" />
      <div role="tabpanel" class="tab-content bg-base-100 border-base-300 p-6">
        <turbo-frame id="contract_activity">
          <div class="flex flex-col gap-3">
            <div class="skeleton h-8 w-48"></div>
            <div class="skeleton h-24 w-full rounded-lg"></div>
            <div class="skeleton h-24 w-full rounded-lg"></div>
          </div>
        </turbo-frame>
      </div>
    <% end %>

    <input id="contract_tab_source" data-turbo-permanent type="radio" name="contract_view" role="tab" class="tab" aria-label="<%= t('contracts.show.tab_source') %>" data-contract-tabs-target="source" data-action="change->contract-tabs#loadTab" />
    <div role="tabpanel" class="tab-content bg-base-100 border-base-300 p-6">
      <turbo-frame id="contract_source">
        <div class="flex flex-col gap-3">
          <div class="skeleton h-8 w-48 mb-3"></div>
          <div class="skeleton h-64 w-full rounded-lg"></div>
        </div>
      </turbo-frame>
    </div>
  </div>
</div>
